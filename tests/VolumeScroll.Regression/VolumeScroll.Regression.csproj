<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The linked models include unrelated window-drag state. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../plugin/Models/MouseEnhanceTypes.cs" Link="MouseEnhanceTypes.cs" />
    <Compile Include="../../plugin/Services/Features/VolumeScrollFeature.cs" Link="VolumeScrollFeature.cs" />
  </ItemGroup>
</Project>
