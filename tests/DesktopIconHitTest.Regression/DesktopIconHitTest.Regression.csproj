<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Unused window-drag fields in the linked production models. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../plugin/Services/Features/DesktopIconHitTest.cs" Link="DesktopIconHitTest.cs" />
    <Compile Include="../../plugin/Models/MouseEnhanceTypes.cs" Link="MouseEnhanceTypes.cs" />
  </ItemGroup>
</Project>
