<shad:ShadWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:shad="https://github.com/tiny-isle/Ti.Avalonia.Shadcn"
                 xmlns:mio="https://github.com/tiny-isle/MioKit"
                 xmlns:views="clr-namespace:MouseEnhance.Views"
                 Width="960"
                 Height="720"
                 MinWidth="460"
                 MinHeight="480"
                 CanPin="True"
                 WindowStartupLocation="CenterScreen"
                 x:Class="MouseEnhance.Views.MouseEnhanceConfigWindow"
                 Title="鼠标增强">
  <Interaction.Behaviors>
    <mio:PluginWindowBehavior Type="com.tinyisle.plugin.mouse-enhance" />
  </Interaction.Behaviors>

  <Grid>
    <views:MouseEnhanceSettingsWebView x:Name="SettingsWebView" />
    <TextBlock x:Name="LoadError" IsVisible="False" Margin="24"
               TextWrapping="Wrap" VerticalAlignment="Center" />
  </Grid>
</shad:ShadWindow>
