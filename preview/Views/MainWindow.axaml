<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MouseEnhance.Preview.Views.MainWindow"
        Title="鼠标增强 · 聚光灯预览"
        Width="480"
        Height="220"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShadBackgroundBrush}">
  <StackPanel Margin="24" Spacing="12">
    <Button Content="预览寻找鼠标" Click="PreviewFindMouse" />
    <TextBlock x:Name="SpotlightError" IsVisible="False" TextWrapping="Wrap" />
  </StackPanel>
</Window>
